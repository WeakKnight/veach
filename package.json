{
  "name": "@tianyuliwiwo/veach",
  "version": "0.2.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Veach: a WebGPU path tracer for glTF and .blend assets (tinybvh + Slang), with a <veach-view> custom element",
  "keywords": [
    "webgpu",
    "path-tracing",
    "renderer",
    "gltf",
    "pbr",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeakKnight/veach.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./view": {
      "types": "./dist-lib/types/view/index.d.ts",
      "import": "./dist-lib/view.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist-lib/types/index.d.ts",
  "module": "./dist-lib/index.js",
  "sideEffects": [
    "./dist-lib/view.js"
  ],
  "files": [
    "dist-lib/*.js",
    "dist-lib/types/**/*.d.ts",
    "docs/PublicAPI.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:shaders": "node scripts/build-shaders.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:bsdf-tables": "node scripts/build-bsdf-tables.mjs",
    "build:bsdf-harness": "node scripts/build-bsdf-harness.mjs",
    "fetch-samples": "node scripts/fetch-samples.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:lut": "node scripts/lut-smoke.mjs",
    "smoke:oidn": "node scripts/oidn-smoke.mjs",
    "fetch-oidn-weights": "node scripts/fetch-oidn-weights.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev:view": "vite --config examples/view/vite.config.ts",
    "build:view": "tsc --noEmit && vite build --config examples/view/vite.config.ts",
    "preview:view": "vite preview --config examples/view/vite.config.ts",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "fzstd": "^0.1.1",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.60",
    "oidn-webgpu": "0.6.0"
  }
}
